<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#155e75">
<title>Ôn thi Đăng ký thuốc — 220 câu + kiến thức trọng tâm</title>
<style>
:root{--ink:#102a43;--muted:#627d98;--brand:#0e7490;--bg:#f2f7fa;--card:#fff;--line:#d9e4ec;--ok:#137547;--bad:#b42318}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 system-ui,-apple-system,"Segoe UI",sans-serif}header{background:linear-gradient(135deg,#164e63,#0e7490);color:white;padding:24px 18px 22px;border-radius:0 0 22px 22px}header h1{font-size:24px;line-height:1.2;margin:0 0 8px}header p{margin:0;color:#d9f3fa;font-size:14px}.wrap{max-width:850px;margin:auto;padding:14px 13px 40px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:-5px}.stat,.panel,.question{background:var(--card);border:1px solid var(--line);border-radius:15px;padding:13px}.stat b{display:block;font-size:21px}.stat span{font-size:12px;color:var(--muted)}.panel{margin-top:12px}.tabs{display:flex;gap:8px;flex-wrap:wrap}.tab,button,select,input{font:inherit}.tab{flex:1 1 28%;padding:10px 8px;border:1px solid var(--line);background:white;border-radius:10px;color:var(--ink);font-weight:650}.tab.active{background:var(--brand);color:white;border-color:var(--brand)}.controls{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.controls>*{min-width:0;flex:1}.field{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}button.primary{background:var(--brand);color:white;border:0;border-radius:10px;padding:12px 14px;font-weight:700}button.secondary{background:#e6f3f7;color:#155e75;border:1px solid #c7e5ed;border-radius:10px;padding:10px 12px;font-weight:650}.question{margin-top:12px;padding:16px}.qmeta{display:flex;justify-content:space-between;gap:8px;color:var(--muted);font-size:13px;margin-bottom:10px}.qtext{font-size:17px;font-weight:700;margin:0 0 13px;white-space:pre-wrap}.option{display:flex;align-items:flex-start;gap:10px;padding:12px;margin:8px 0;border:1px solid var(--line);border-radius:11px;background:white;text-align:left;width:100%;color:var(--ink);line-height:1.45}.option .letter{flex:none;width:25px;height:25px;display:grid;place-items:center;background:#edf4f7;border-radius:7px;font-weight:750}.option.chosen{border-color:var(--brand);background:#eaf7fa}.option.correct{border-color:#4caf80;background:#ecfdf3}.option.wrong{border-color:#e68b84;background:#fff1f0}.feedback{padding:12px;border-radius:10px;margin-top:12px;background:#f0f9ff;border:1px solid #cfe8f4}.feedback.good{background:#ecfdf3;border-color:#b7e4c7}.feedback.bad{background:#fff1f0;border-color:#f2c2bd}.feedback b{display:block;margin-bottom:4px}.explain{font-size:14px;margin-top:7px}.nav{display:flex;gap:8px;margin-top:13px}.nav button{flex:1}.progress{height:7px;background:#dce8ef;border-radius:10px;overflow:hidden;margin-top:9px}.progress div{height:100%;background:#22a1b8;width:0;transition:width .2s}.small{font-size:13px;color:var(--muted)}.hidden{display:none!important}.listitem{padding:12px 0;border-bottom:1px solid var(--line)}.listitem:last-child{border:0}.listitem button{border:0;background:none;color:var(--brand);font-weight:700;text-align:left;padding:0}.pill{font-size:12px;background:#e6f3f7;border-radius:30px;padding:3px 8px;color:#155e75}.results{text-align:center;padding:22px 12px}.results strong{font-size:36px;display:block}.history-item{padding:12px 0;border-bottom:1px solid var(--line)}.history-item:last-child{border:0}.foot{text-align:center;color:var(--muted);font-size:12px;padding:18px 4px}.knowledge-card{border:1px solid var(--line);border-radius:12px;margin:10px 0;background:#fff;overflow:hidden}.knowledge-card summary{padding:14px;cursor:pointer;line-height:1.4}.knowledge-body{padding:0 14px 12px}.knowledge-item{border-top:1px solid var(--line);padding:10px 0}.knowledge-item h4{margin:0 0 4px;font-size:15px;color:#155e75}.knowledge-item p{margin:0;font-size:14px;line-height:1.55}.knowledge-card[open] summary{background:#eef8fb}@media(min-width:650px){header{padding:30px max(calc((100vw - 820px)/2),22px)}.wrap{padding-top:20px}.question{padding:22px}}

.theory-card{border:1px solid var(--line,#d9dee8);border-radius:12px;margin:10px 0;background:var(--card,#fff);overflow:hidden}
.theory-card>summary{cursor:pointer;padding:14px;display:flex;gap:8px;justify-content:space-between;align-items:flex-start;line-height:1.45}
.theory-body{padding:0 14px 14px;line-height:1.65;overflow-wrap:anywhere}
.theory-heading{font-size:1rem;margin:16px 0 6px;line-height:1.4}
.theory-paragraph,.theory-bullet{margin:7px 0;line-height:1.65;white-space:normal}
.theory-bullet{padding-left:8px}
.theory-table-wrap{overflow-x:auto;margin:10px 0;max-width:100%}
.theory-table{border-collapse:collapse;width:100%;font-size:.9rem;min-width:360px}
.theory-table th,.theory-table td{border:1px solid var(--line,#d9dee8);padding:8px;vertical-align:top;text-align:left}
.theory-table th{font-weight:700;background:rgba(120,130,150,.10)}
.tabs{overflow-x:auto;flex-wrap:nowrap;-webkit-overflow-scrolling:touch}
.tabs .tab{flex:0 0 auto;white-space:nowrap}
</style></head><body><header><h1>Ôn thi Đăng ký thuốc</h1><p>Học phần 7DHO472 · 6 bài · 220 câu hỏi kèm đáp án và giải thích</p></header><main class="wrap"><section class="stats"><div class="stat"><b>220</b><span>Câu hỏi</span></div><div class="stat"><b>6</b><span>Bài ôn tập</span></div><div class="stat"><b id="mastered">0</b><span>Câu đã trả lời đúng</span></div></section><section class="panel"><div class="tabs"><button class="tab active" id="studyTab">Ôn từng câu</button><button class="tab" id="quizTab">Thi thử</button><button class="tab" id="browseTab">Danh sách</button><button class="tab" id="wrongTab">Câu sai</button><button class="tab" id="historyTab">Lịch sử</button><button class="tab" id="knowledgeTab">Kiến thức trọng tâm</button><button class="tab" id="theoryTab">Lý thuyết 6 bài</button></div><div id="setup"><div class="controls"><select class="field" id="lesson"><option value="0">Tất cả 6 bài</option><option value="1">Bài 1 · Câu 1–37</option><option value="2">Bài 2 · Câu 38–74</option><option value="3">Bài 3 · Câu 75–111</option><option value="4">Bài 4 · Câu 112–148</option><option value="5">Bài 5 · Câu 149–184</option><option value="6">Bài 6 · Câu 185–220</option></select><select class="field" id="count"><option value="10">10 câu</option><option value="20">20 câu</option><option value="37">37 câu</option><option value="50">50 câu</option><option value="220">Tất cả câu</option></select></div><div class="controls"><input class="field" id="search" placeholder="Tìm từ khóa hoặc số câu…"><button class="primary" id="start">Bắt đầu ôn</button></div><p class="small">Chọn bài hoặc tìm nội dung trước khi bắt đầu. Lịch sử và câu sai được lưu trên trình duyệt nếu trình duyệt cho phép. Nên mở bằng Chrome, không mở ở chế độ xem trước tệp.</p></div></section><section id="quizArea" class="question hidden"></section><section id="browseArea" class="panel hidden"><input class="field" id="browseSearch" placeholder="Tìm câu hỏi…"><div id="browseList"></div></section><section id="historyArea" class="panel hidden"></section><section id="knowledgeArea" class="panel hidden"><h2>Kiến thức trọng tâm · 6 bài</h2><p class="small">Tóm tắt theo tài liệu Word bạn cung cấp. Mở từng bài để xem các ý cần nhớ; dùng ô tìm kiếm để lọc nội dung.</p><input class="field" id="knowledgeSearch" placeholder="Tìm kiến thức, văn bản, thuật ngữ…"><div id="knowledgeList"></div></section><section id="theoryArea" class="panel hidden"><h2>Lý thuyết đầy đủ · 6 bài</h2><p class="small">Nội dung được đưa từ tài liệu Word “Tổng hợp 6 bài Hồ sơ đăng ký thuốc” bạn vừa gửi. Mở từng bài để đọc; tìm theo từ khóa, văn bản hoặc thuật ngữ.</p><input class="field" id="theorySearch" placeholder="Tìm trong lý thuyết 6 bài…"><div id="theoryList"></div></section><div class="foot">Tài liệu ôn tập được chuyển từ file Word bạn gửi. Hãy đối chiếu với tài liệu chính thức của giảng viên khi cần.</div></main><script>
const DATA=[{"n": 1, "q": "Xét về bản chất cốt lõi, đăng ký thuốc là hoạt động kết hợp giữa hai phương diện nào sau đây?", "options": {"A": "Kỹ thuật và Tài chính", "B": "Pháp lý và Kỹ thuật", "C": "Pháp lý và Thương mại", "D": "Hành chính và Marketing"}, "answer": "B", "explanation": "Đăng ký thuốc là hoạt động pháp lý – kỹ thuật: vừa phải tuân thủ quy định pháp luật, vừa phải đánh giá dữ liệu chuyên môn về chất lượng, an toàn và hiệu quả.", "lesson": 1}, {"n": 2, "q": "Văn bản chuyên ngành nào trực tiếp quy định hồ sơ, thủ tục đăng ký lưu hành thuốc hóa dược, vắc xin, sinh phẩm, thuốc dược liệu và nguyên liệu làm thuốc dùng cho người?", "options": {"A": "Thông tư số 29/2025/TT-BYT", "B": "Thông tư số 32/2025/TT-BYT", "C": "Thông tư số 30/2025/TT-BYT", "D": "Thông tư số 12/2025/TT-BYT"}, "answer": "D", "explanation": "Thông tư 12/2025/TT-BYT trực tiếp quy định hồ sơ, thủ tục đăng ký đối với thuốc hóa dược, vắc xin, sinh phẩm, thuốc dược liệu và nguyên liệu làm thuốc dùng cho người.", "lesson": 1}, {"n": 3, "q": "Đâu là cơ quan chuyên môn thuộc Bộ Y tế thực hiện nhiệm vụ quản lý, tiếp nhận và thẩm định hồ sơ đối với thuốc cổ truyền và vị thuốc cổ truyền?", "options": {"A": "Cơ quan chuyên môn về y tế cấp tỉnh", "B": "Cục Quản lý Y, Dược cổ truyền", "C": "Cục Quản lý Khám, chữa bệnh", "D": "Cục Quản lý Dược"}, "answer": "B", "explanation": "Cục Quản lý Y, Dược cổ truyền là cơ quan chuyên môn thuộc Bộ Y tế phụ trách nhóm thuốc cổ truyền và vị thuốc cổ truyền.", "lesson": 1}, {"n": 4, "q": "Thuật ngữ ACTD được sử dụng trong hoạt động đăng ký thuốc là viết tắt của cụm từ nào?", "options": {"A": "Hồ sơ hành chính chung ASEAN", "B": "Hồ sơ đánh giá chung ASEAN", "C": "Hồ sơ kỹ thuật chung quốc tế", "D": "Hồ sơ kỹ thuật chung ASEAN"}, "answer": "D", "explanation": "ACTD là ASEAN Common Technical Dossier – Hồ sơ kỹ thuật chung ASEAN.", "lesson": 1}, {"n": 5, "q": "Trong hệ thống văn bản pháp luật về đăng ký thuốc, văn bản nào đóng vai trò nền tảng, quy định các nguyên tắc, thẩm quyền và điều kiện lưu hành cơ bản nhất?", "options": {"A": "Luật Dược số 105/2016/QH13 và Luật sửa đổi số 44/2024/QH15", "B": "Nghị định số 163/2025/NĐ-CP và các phụ lục hướng dẫn thi hành", "C": "Thông tư số 12/2025/TT-BYT và Thông tư số 29/2025/TT-BYT", "D": "Thông tư số 01/2018/TT-BYT được sửa đổi bởi Thông tư số 23/2023/TT-BYT"}, "answer": "A", "explanation": "Luật Dược 105/2016/QH13 và Luật sửa đổi 44/2024/QH15 là nền tảng pháp lý, quy định các nguyên tắc, thẩm quyền và điều kiện lưu hành cơ bản.", "lesson": 1}, {"n": 6, "q": "Trách nhiệm đầu tiên và quan trọng nhất của cơ sở đăng ký thuốc đối với tài liệu trong hồ sơ nộp cho cơ quan quản lý là gì?", "options": {"A": "Bảo đảm mọi tài liệu được trình bày đúng mẫu, đúng thứ tự và có bản dịch tiếng Việt", "B": "Bảo đảm tính chính xác, hợp pháp và trung thực của tất cả tài liệu", "C": "Bảo đảm thuốc đã có kế hoạch sản xuất, phân phối và dự kiến giá bán tại Việt Nam", "D": "Bảo đảm hồ sơ được nộp đúng thời hạn, đã hoàn thành phí và có phiếu tiếp nhận"}, "answer": "B", "explanation": "Cơ sở đăng ký phải chịu trách nhiệm về tính chính xác, hợp pháp và trung thực của tài liệu trong hồ sơ, ngoài phần trách nhiệm thuộc về cơ sở sản xuất.", "lesson": 1}, {"n": 7, "q": "Thuốc đã có giấy đăng ký lưu hành nhưng sắp hết thời hạn hiệu lực, cơ sở đăng ký cần lập loại hồ sơ nào để thuốc tiếp tục được lưu hành hợp pháp?", "options": {"A": "Hồ sơ đề nghị gia hạn giấy đăng ký lưu hành", "B": "Hồ sơ đề nghị cấp giấy đăng ký lưu hành", "C": "Hồ sơ đề nghị thu hồi giấy đăng ký lưu hành", "D": "Hồ sơ đề nghị thay đổi giấy đăng ký lưu hành"}, "answer": "A", "explanation": "Giấy đăng ký lưu hành sắp hết hiệu lực thì lập hồ sơ đề nghị gia hạn để tiếp tục lưu hành hợp pháp.", "lesson": 1}, {"n": 8, "q": "Văn bản nào đóng vai trò quy định cụ thể thành phần hồ sơ, thủ tục, biểu mẫu, yêu cầu kỹ thuật và hoạt động thẩm định trong thực tiễn hàng ngày của nhân viên Pháp chế Dược?", "options": {"A": "Thông tư của Bộ Y tế", "B": "Nghị định của Chính phủ", "C": "Quyết định của Bộ Y tế", "D": "Luật do Quốc hội ban hành"}, "answer": "A", "explanation": "Thông tư của Bộ Y tế quy định cụ thể thành phần hồ sơ, thủ tục, biểu mẫu và yêu cầu kỹ thuật trong thực tiễn đăng ký thuốc.", "lesson": 1}, {"n": 9, "q": "Chủ thể nào đứng tên nộp đơn và chịu trách nhiệm toàn diện trước pháp luật về tính chính xác, hợp pháp, trung thực của hồ sơ đăng ký, trừ phần trách nhiệm được giao cho cơ sở sản xuất?", "options": {"A": "Cơ sở sản xuất thuốc", "B": "Cơ sở phân phối thuốc", "C": "Cơ sở đăng ký thuốc", "D": "Cơ sở nhập khẩu thuốc"}, "answer": "C", "explanation": "Cơ sở đăng ký là chủ thể đứng tên nộp hồ sơ và chịu trách nhiệm toàn diện trước pháp luật về hồ sơ, trừ phần trách nhiệm được giao cho cơ sở sản xuất.", "lesson": 1}, {"n": 10, "q": "Ranh giới học thuật cốt lõi để phân biệt giữa \"Thuốc dược liệu\" (áp dụng Thông tư 12/2025/TT-BYT) và \"Thuốc cổ truyền\" (áp dụng Thông tư 29/2025/TT-BYT) là gì?", "options": {"A": "Thuốc dược liệu do Cục Quản lý Dược cấp phép, còn thuốc cổ truyền do cơ quan cấp tỉnh cấp phép", "B": "Thuốc dược liệu tác dụng theo bằng chứng khoa học, thuốc cổ truyền phối ngũ theo lý luận y học cổ truyền hoặc kinh nghiệm dân gian", "C": "Thuốc dược liệu được bào chế từ một dược liệu, còn thuốc cổ truyền phải có từ hai dược liệu trở lên", "D": "Thuốc dược liệu chỉ sử dụng dạng bào chế hiện đại, còn thuốc cổ truyền chỉ sử dụng dạng bào chế truyền thống"}, "answer": "B", "explanation": "Thuốc dược liệu và thuốc cổ truyền là hai nhóm được điều chỉnh bởi các thông tư khác nhau. Câu hỏi nhấn mạnh căn cứ hình thành/phát triển: thuốc cổ truyền gắn với lý luận y học cổ truyền hoặc kinh nghiệm dân gian, còn thuốc dược liệu thuộc phạm vi TT12.", "lesson": 1}, {"n": 11, "q": "Trong hồ sơ thay đổi, bổ sung giấy đăng ký lưu hành, việc phân loại thành Thay đổi lớn (MaV) và Thay đổi nhỏ (MiV) chủ yếu dựa trên tiêu chí nào?", "options": {"A": "Số lượng tài liệu phải nộp, số tiểu ban thẩm định và thời gian xử lý hồ sơ", "B": "Việc thay đổi thuộc nhóm hành chính hay kỹ thuật theo đề xuất chủ quan của cơ sở", "C": "Mức độ thay đổi về chi phí sản xuất, quy mô đầu tư và giá thành của sản phẩm", "D": "Mức độ ảnh hưởng trực tiếp đến chất lượng, an toàn và hiệu quả của thuốc"}, "answer": "D", "explanation": "Phân loại thay đổi lớn/nhỏ nhằm phản ánh mức độ ảnh hưởng của thay đổi đối với chất lượng, an toàn và hiệu quả của thuốc; việc phân loại cụ thể phải đối chiếu bảng/phụ lục tương ứng.", "lesson": 1}, {"n": 12, "q": "Thuốc không lưu hành trên thị trường trong 05 năm kể từ ngày giấy đăng ký lưu hành có hiệu lực vẫn có thể được xem xét gia hạn trong trường hợp ngoại lệ nào?", "options": {"A": "Là thuốc hiếm; hoặc thuộc nhóm chỉ có không quá 03 thuốc của 03 hãng cùng dược chất hoặc dược liệu, dạng bào chế, hàm lượng hoặc nồng độ còn giấy đăng ký hiệu lực", "B": "Là biệt dược gốc hoặc thuốc đã được một cơ quan SRA cấp phép, không phụ thuộc số lượng thuốc cùng nhóm còn giấy đăng ký tại Việt Nam", "C": "Là thuốc hiếm; hoặc thuộc nhóm có không quá 05 thuốc của 05 hãng cùng dược chất hoặc dược liệu, dạng bào chế, hàm lượng hoặc nồng độ còn giấy đăng ký hiệu lực", "D": "Là thuốc sản xuất trong nước đã từng trúng thầu, dù có nhiều thuốc cùng dược chất, dạng bào chế và hàm lượng đang lưu hành"}, "answer": "A", "explanation": "Ngoại lệ được nêu trong câu là thuốc hiếm hoặc nhóm chỉ còn không quá 03 thuốc của 03 hãng cùng dược chất/dược liệu, dạng bào chế, hàm lượng hoặc nồng độ còn GĐKLH.", "lesson": 1}, {"n": 13, "q": "Theo Điều 31 Thông tư số 12/2025/TT-BYT, hồ sơ đề nghị cấp giấy đăng ký lưu hành của nhóm nào phải có Kế hoạch quản lý nguy cơ (RMP)?", "options": {"A": "Mọi thuốc generic thuộc trường hợp phải báo cáo tương đương sinh học", "B": "Mọi thuốc cổ truyền có thành phần dược liệu độc trong công thức", "C": "Thuốc hóa dược mới, vắc xin và sinh phẩm, trừ sinh phẩm probiotics", "D": "Thuốc dược liệu không phải thuốc mới và nguyên liệu làm thuốc"}, "answer": "C", "explanation": "Theo Điều 31 TT12/2025/TT-BYT, RMP áp dụng cho thuốc hóa dược mới, vắc xin và sinh phẩm, trừ sinh phẩm probiotics.", "lesson": 1}, {"n": 14, "q": "Tại sao nhân viên pháp chế không thể chỉ dựa vào \"Tên thương mại\" (Brand name) của sản phẩm để xác định văn bản pháp luật áp dụng cho hồ sơ đăng ký?", "options": {"A": "Vì tên thương mại do cơ quan quản lý cấp ngẫu nhiên, không gắn với bản chất sản phẩm", "B": "Vì tên thương mại chỉ được dùng sau khi cấp phép, không xuất hiện trong hồ sơ đăng ký", "C": "Vì tên thương mại chỉ phản ánh dạng bào chế và hàm lượng, không thể hiện chủ sở hữu giấy phép", "D": "Vì tên thương mại do công ty tự đặt, không phản ánh thành phần, nguồn gốc và cơ chế tác dụng thực sự của thuốc"}, "answer": "D", "explanation": "Tên thương mại không đủ để xác định nhóm sản phẩm và căn cứ pháp lý. Phải xem thành phần, nguồn gốc và bản chất sản phẩm để chọn đúng văn bản áp dụng.", "lesson": 1}, {"n": 15, "q": "Theo nguyên tắc tra cứu pháp luật trong đăng ký thuốc, hai bước đầu tiên mang tính chất \"tọa độ ban đầu\" để khoanh vùng chính xác văn bản cần áp dụng là gì?", "options": {"A": "Xác định nhóm sản phẩm và xác định loại hồ sơ", "B": "Xác định cơ sở sản xuất và xác định nước sản xuất", "C": "Xác định tên thuốc và xác định dạng bào chế", "D": "Xác định phí thẩm định và xác định thời hạn xử lý"}, "answer": "A", "explanation": "Hai bước đầu tiên khi tra cứu là xác định nhóm sản phẩm và xác định loại hồ sơ. Đây là 'tọa độ' để khoanh vùng văn bản và yêu cầu áp dụng.", "lesson": 1}, {"n": 16, "q": "Nhận định nào phân biệt đúng “vị thuốc cổ truyền” với “thuốc cổ truyền” theo Luật Dược số 105/2016/QH13 được sửa đổi bởi Luật số 44/2024/QH15?", "options": {"A": "Vị thuốc cổ truyền chỉ được dùng tại cơ sở khám bệnh, chữa bệnh; thuốc cổ truyền luôn được miễn đăng ký nếu dùng theo lý luận y học cổ truyền", "B": "Vị thuốc cổ truyền là thuốc thành phẩm chỉ chứa một dược liệu đã bào chế; thuốc cổ truyền bắt buộc chứa từ hai dược liệu trở lên và đều là thuốc thành phẩm", "C": "Vị thuốc cổ truyền là dược liệu chưa qua sơ chế hoặc chế biến; thuốc cổ truyền là mọi dược liệu đã chia liều, đóng gói và ghi công dụng để bán lẻ", "D": "Vị thuốc cổ truyền là dược liệu đã được sơ chế, chế biến theo lý luận y học cổ truyền hoặc kinh nghiệm dân gian; thuốc cổ truyền là thuốc được phối ngũ và bào chế để sử dụng"}, "answer": "D", "explanation": "Vị thuốc cổ truyền là dược liệu đã được sơ chế, chế biến theo lý luận y học cổ truyền hoặc kinh nghiệm dân gian; thuốc cổ truyền là thuốc được phối ngũ và bào chế để sử dụng.", "lesson": 1}, {"n": 17, "q": "Theo quy định về trách nhiệm cảnh giác dược sau cấp phép, nếu thuốc đã được cấp giấy đăng ký lưu hành tại Việt Nam bị cơ quan quản lý nước ngoài quyết định thu hồi, cơ sở đăng ký thuốc phải làm gì?", "options": {"A": "Chỉ thông báo cho nhà phân phối tại Việt Nam và chờ yêu cầu chính thức từ Cục Quản lý Dược", "B": "Tự bổ sung cảnh báo vào tờ hướng dẫn sử dụng rồi tiếp tục lưu hành mà không cần báo cáo", "C": "Thông báo bằng văn bản cho cơ quan quản lý tại Việt Nam trong thời hạn quy định và nêu rõ lý do thu hồi", "D": "Chờ đến kỳ báo cáo an toàn định kỳ hoặc hồ sơ gia hạn để tổng hợp sự kiện thu hồi"}, "answer": "C", "explanation": "Khi thuốc đã được cấp GĐKLH tại Việt Nam mà bị cơ quan quản lý nước ngoài quyết định thu hồi, cơ sở đăng ký phải thông báo bằng văn bản cho cơ quan quản lý Việt Nam trong thời hạn quy định và nêu lý do.", "lesson": 1}, {"n": 18, "q": "Bên cạnh các Thông tư quy định về thành phần hồ sơ và chất lượng (như Thông tư số 12/2025/TT-BYT), hồ sơ đăng ký thuốc bắt buộc phải đối chiếu với Thông tư số 01/2018/TT-BYT và Thông tư số 23/2023/TT-BYT để thực hiện yêu cầu kỹ thuật nào?", "options": {"A": "Thiết kế nhãn thuốc và tờ hướng dẫn sử dụng thuốc", "B": "Thiết kế quy trình sản xuất và tiêu chuẩn chất lượng thuốc", "C": "Lập báo cáo nghiên cứu tương đương sinh học của thuốc", "D": "Xây dựng kế hoạch quản lý nguy cơ và báo cáo an toàn"}, "answer": "A", "explanation": "TT01/2018/TT-BYT được sửa đổi bởi TT23/2023/TT-BYT quy định yêu cầu về nhãn thuốc và tờ hướng dẫn sử dụng.", "lesson": 1}, {"n": 19, "q": "Một vắc xin mới nhập khẩu đề nghị cấp giấy đăng ký lưu hành. Ngoài hồ sơ hành chính và hồ sơ chất lượng, tổ hợp tài liệu nào còn phải được nộp theo Điều 31 Thông tư số 12/2025/TT-BYT?", "options": {"A": "Hồ sơ tiền lâm sàng, hồ sơ lâm sàng và Kế hoạch quản lý nguy cơ", "B": "Báo cáo độ ổn định, hồ sơ phân phối và kế hoạch quảng cáo thuốc", "C": "Báo cáo tương đương sinh học, hồ sơ lâm sàng và báo cáo giá thuốc", "D": "Hồ sơ tiền lâm sàng, báo cáo thầu và tài liệu công bố giá bán buôn"}, "answer": "A", "explanation": "Vắc xin mới ngoài hồ sơ hành chính và chất lượng còn phải có hồ sơ tiền lâm sàng, lâm sàng và Kế hoạch quản lý nguy cơ.", "lesson": 1}, {"n": 20, "q": "Tình huống: Công ty X nghiên cứu thành công một sản phẩm dạng viên nang có thành phần gồm 5 loại cao chiết xuất từ dược liệu. Tuy nhiên, công thức này được phát triển dựa trên các thử nghiệm dược lý học hiện đại và không dựa vào lý luận y học cổ truyền. Khi lập hồ sơ pháp lý, chuyên viên đăng ký cần xếp sản phẩm này vào nhóm nào và tuân thủ Thông tư nào?", "options": {"A": "Nhóm Thuốc hóa dược, áp dụng Thông tư số 12/2025/TT-BYT", "B": "Nhóm Thuốc cổ truyền, áp dụng Thông tư số 29/2025/TT-BYT", "C": "Nhóm Thuốc dược liệu, áp dụng Thông tư số 12/2025/TT-BYT", "D": "Nhóm Vị thuốc cổ truyền, áp dụng Thông tư số 29/2025/TT-BYT"}, "answer": "C", "explanation": "Sản phẩm chứa các cao dược liệu nhưng được phát triển dựa trên thử nghiệm dược lý hiện đại, không dựa trên lý luận y học cổ truyền, được xếp là thuốc dược liệu và áp dụng TT12.", "lesson": 1}, {"n": 21, "q": "Tình huống giao thoa pháp lý: Luật số 44/2024/QH15 sửa đổi Luật Dược có hiệu lực chính thức từ ngày 01/7/2025. Tuy nhiên, khoản 30 Điều 1 về \"gia hạn giấy đăng ký lưu hành\" lại có quy định hiệu lực riêng từ ngày 01/01/2025. Nếu một công ty nộp hồ sơ gia hạn vào tháng 3/2025, họ phải căn cứ vào quy định gia hạn của văn bản nào?", "options": {"A": "Khoản 30 Điều 1 Luật số 44/2024/QH15 do điều khoản này đã có hiệu lực pháp lý từ ngày 01/01/2025", "B": "Thông tư số 12/2025/TT-BYT vì văn bản này đã điều chỉnh thủ tục gia hạn từ ngày 01/01/2025", "C": "Luật Dược số 105/2016/QH13 vì toàn bộ Luật số 44/2024/QH15 chưa có hiệu lực vào tháng 3/2025", "D": "Quy định chuyển tiếp của Nghị định số 163/2025/NĐ-CP vì nghị định được áp dụng hồi tố cho hồ sơ gia hạn"}, "answer": "A", "explanation": "Khoản 30 Điều 1 Luật 44/2024/QH15 có hiệu lực riêng từ 01/01/2025, nên hồ sơ gia hạn tháng 3/2025 phải căn cứ quy định này.", "lesson": 1}, {"n": 22, "q": "Doanh nghiệp thay đổi cơ sở sản xuất nhưng không đối chiếu quy định phân loại trước khi nộp hồ sơ. Rủi ro tuân thủ trọng yếu nhất là gì?", "options": {"A": "Cơ quan quản lý có trách nhiệm tự chuyển hồ sơ sang thủ tục phù hợp, tự xác định biểu mẫu và bổ sung các tài liệu còn thiếu cho doanh nghiệp", "B": "Lựa chọn sai thủ tục, thiếu tài liệu phải nộp và có thể áp dụng nội dung thay đổi khi chưa được cấp mới, phê duyệt hoặc công khai theo đúng cơ chế", "C": "Chỉ phát sinh chênh lệch về phí và thời hạn thẩm định; nội dung thay đổi vẫn được áp dụng ngay nếu lô thuốc đạt tiêu chuẩn chất lượng", "D": "Mọi thay đổi về cơ sở sản xuất đều có thể áp dụng trước, sau đó hợp thức hóa trong hồ sơ gia hạn nếu công thức thuốc không thay đổi"}, "answer": "B", "explanation": "Không phân loại thay đổi trước khi nộp có thể dẫn tới chọn sai thủ tục, thiếu tài liệu và áp dụng thay đổi khi chưa được phê duyệt/công khai theo cơ chế tương ứng.", "lesson": 1}, {"n": 23, "q": "Nhận định nào phân biệt đúng giữa cơ chế tham chiếu kết quả thẩm định khi cấp giấy đăng ký lưu hành và cơ chế gia hạn không yêu cầu tư vấn của Hội đồng?", "options": {"A": "Tham chiếu dựa trên báo cáo thẩm định chính thức của cơ quan được chấp nhận; gia hạn không yêu cầu Hội đồng phụ thuộc việc hồ sơ không thuộc các trường hợp nguy cơ quy định tại Điều 43 Thông tư số 12/2025/TT-BYT", "B": "Cả hai cơ chế đều tự động áp dụng khi thuốc đã được một cơ quan SRA cấp phép; cơ sở không phải nộp báo cáo thẩm định, đối chiếu hồ sơ, chứng minh điều kiện nguy cơ hoặc thực hiện nghĩa vụ sau cấp phép tại Việt Nam", "C": "Tham chiếu là công nhận tự động quyết định nước ngoài; gia hạn không yêu cầu Hội đồng là miễn thẩm định toàn bộ hồ sơ, dữ liệu chất lượng và dữ liệu an toàn", "D": "Tham chiếu chỉ dùng cho hồ sơ gia hạn thuốc nhập khẩu; gia hạn không yêu cầu Hội đồng chỉ dùng cho thuốc sản xuất trong nước và không phải thẩm định dữ liệu sau cấp phép"}, "answer": "A", "explanation": "Tham chiếu dựa trên báo cáo thẩm định chính thức của cơ quan được chấp nhận; cơ chế gia hạn không yêu cầu Hội đồng phụ thuộc điều kiện hồ sơ không thuộc các trường hợp nguy cơ quy định tại Điều 43 TT12.", "lesson": 1}, {"n": 24, "q": "Thuốc nhập khẩu do nhà máy nước ngoài sản xuất bị phát hiện không đạt chất lượng. Chủ thể nào là đầu mối chịu trách nhiệm trước cơ quan quản lý Việt Nam về hồ sơ đăng ký, phối hợp giải trình và thực hiện nghĩa vụ sau cấp phép?", "options": {"A": "Cơ sở bán lẻ đầu tiên phát hiện vi phạm", "B": "Cơ quan cấp CPP tại nước sản xuất", "C": "Cơ sở vận chuyển quốc tế của lô thuốc", "D": "Cơ sở đăng ký thuốc tại Việt Nam"}, "answer": "D", "explanation": "Cơ sở đăng ký tại Việt Nam là đầu mối chịu trách nhiệm trước cơ quan quản lý về hồ sơ, giải trình và các nghĩa vụ sau cấp phép đối với thuốc nhập khẩu.", "lesson": 1}, {"n": 25, "q": "Nếu nhầm “vị thuốc cổ truyền” là “thuốc cổ truyền” khi lựa chọn bộ hồ sơ, hậu quả chuyên môn trực tiếp nhất là gì?", "options": {"A": "Chỉ sai yêu cầu tương đương sinh học; vị thuốc cổ truyền luôn phải có báo cáo BE như thuốc generic", "B": "Lựa chọn sai cấu trúc, thành phần và yêu cầu chất lượng tương ứng giữa hồ sơ của nguyên liệu và hồ sơ của thuốc thành phẩm", "C": "Chỉ sai tên sản phẩm trên đơn; toàn bộ tài liệu hành chính và kỹ thuật vẫn có thể giữ nguyên", "D": "Chỉ sai mẫu nhãn; tiêu chuẩn chất lượng, quy trình chế biến, yêu cầu nguồn nguyên liệu và thành phần hồ sơ của hai nhóm sản phẩm hoàn toàn giống nhau"}, "answer": "B", "explanation": "Nhầm vị thuốc cổ truyền với thuốc cổ truyền dẫn đến chọn sai cấu trúc hồ sơ, thành phần và yêu cầu chất lượng giữa nguyên liệu/vị thuốc và thuốc thành phẩm.", "lesson": 1}, {"n": 26, "q": "Việc cố tình che giấu và sửa chữa trái phép dữ liệu thử nghiệm lâm sàng để nộp hồ sơ xin cấp số đăng ký là vi phạm nghiêm trọng trực tiếp vào trách nhiệm nào sau đây của cơ sở đăng ký thuốc?", "options": {"A": "Trách nhiệm cập nhật văn bản và lựa chọn đúng biểu mẫu hành chính tại thời điểm nộp hồ sơ", "B": "Trách nhiệm bảo mật bí mật kinh doanh và dữ liệu độc quyền của cơ sở sản xuất", "C": "Tính trung thực trong học thuật và trách nhiệm bảo đảm tính chính xác, hợp pháp của hồ sơ", "D": "Trách nhiệm giải quyết tranh chấp nhãn hiệu, sáng chế và quyền sở hữu trí tuệ của thuốc"}, "answer": "C", "explanation": "Che giấu hoặc sửa trái phép dữ liệu lâm sàng vi phạm trực tiếp yêu cầu về tính trung thực, chính xác và hợp pháp của hồ sơ đăng ký.", "lesson": 1}, {"n": 27, "q": "Cơ sở đăng ký nhận được thông tin về nhiều biến cố bất lợi nghiêm trọng, chưa được ghi trong tờ hướng dẫn sử dụng. Cách xử lý phù hợp nhất với nghĩa vụ cảnh giác dược là gì?", "options": {"A": "Tự quyết định thu hồi giấy đăng ký và tiêu hủy toàn bộ thuốc trên thị trường mà không cần báo cáo, đánh giá hoặc phối hợp với cơ quan quản lý", "B": "Chỉ tổng hợp các trường hợp vào báo cáo định kỳ gần nhất, không cần báo cáo đơn lẻ hoặc đánh giá sớm vì thông tin chưa có trong tờ hướng dẫn sử dụng", "C": "Khẩn trương phối hợp thu thập, đánh giá và gửi báo cáo theo thời hạn, hình thức của Hướng dẫn quốc gia về cảnh giác dược; đồng thời phối hợp biện pháp bảo đảm an toàn", "D": "Tự sửa ngay tờ hướng dẫn sử dụng, gửi thông báo cho hệ thống phân phối và áp dụng nội dung mới trước khi thực hiện thủ tục thay đổi, bổ sung"}, "answer": "C", "explanation": "Biến cố bất lợi nghiêm trọng cần được khẩn trương thu thập, đánh giá và báo cáo theo Hướng dẫn quốc gia về cảnh giác dược, đồng thời phối hợp các biện pháp bảo đảm an toàn.", "lesson": 1}, {"n": 28, "q": "Một công ty Việt Nam đăng ký thuốc, nhưng phát hiện tên thương hiệu thuốc của mình xâm phạm quyền sở hữu trí tuệ của một tập đoàn dược phẩm đa quốc gia đã đăng ký bảo hộ nhãn hiệu. Trong trường hợp này, Bộ Y tế có chịu trách nhiệm bồi thường vì đã cấp giấy đăng ký lưu hành cho công ty Việt Nam không?", "options": {"A": "Không, vì tên thuốc đã được cấp giấy đăng ký lưu hành thì tự động được miễn áp dụng pháp luật sở hữu trí tuệ và chủ sở hữu nhãn hiệu không có quyền yêu cầu chấm dứt lưu hành", "B": "Không, Bộ Y tế chỉ thẩm định chuyên môn dược; cơ sở đăng ký tự chịu trách nhiệm về tranh chấp sở hữu trí tuệ theo quy định của pháp luật về sở hữu trí tuệ", "C": "Có, vì quyết định cấp giấy đăng ký lưu hành đồng thời xác nhận tên thuốc không xâm phạm quyền sở hữu trí tuệ; Bộ Y tế phải cùng cơ sở đăng ký bồi thường toàn bộ thiệt hại phát sinh", "D": "Có một phần, vì Bộ Y tế chịu trách nhiệm kiểm tra đăng ký nhãn hiệu trước khi cấp phép; cơ sở đăng ký chỉ chịu trách nhiệm đối với phần thiệt hại do tiếp tục kinh doanh sau khi có tranh chấp"}, "answer": "B", "explanation": "Cơ sở đăng ký tự chịu trách nhiệm về vấn đề sở hữu trí tuệ của thuốc theo pháp luật sở hữu trí tuệ; việc được cấp GĐKLH không đồng nghĩa được miễn trách nhiệm về quyền SHTT.", "lesson": 1}, {"n": 29, "q": "Tình huống: Công ty Dược Y có một giấy đăng ký lưu hành thuốc hóa dược", "options": {"A": "Bị từ chối gia hạn vì mọi thuốc không lưu hành đủ 05 năm đều mất quyền gia hạn, không có ngoại lệ", "B": "Chỉ được gia hạn 03 năm vì thuốc hiếm phải tiếp tục theo dõi an toàn, hiệu quả sau mỗi kỳ cấp phép", "C": "Sẽ được gia hạn bình thường do pháp luật có quy định ngoại lệ (miễn trừ yêu cầu lưu hành 5 năm) đối với thuốc hiếm", "D": "Phải chuyển sang thủ tục cấp mới vì việc không lưu hành làm giấy đăng ký lưu hành cũ mất giá trị"}, "answer": "C", "explanation": "Thuốc hiếm thuộc ngoại lệ đối với yêu cầu lưu hành 5 năm, nên trường hợp nêu trong câu vẫn có thể được xem xét gia hạn.", "lesson": 1}, {"n": 30, "q": "Trong tình huống văn bản pháp luật cũ (dùng làm cơ sở lập hồ sơ trước đây) có quy định khác biệt so với văn bản mới vừa được ban hành và có hiệu lực, nguyên tắc tối thượng của người làm Pháp chế Dược để bảo vệ hồ sơ không bị từ chối là gì?", "options": {"A": "Tiếp tục áp dụng văn bản cũ đã dùng khi chuẩn bị hồ sơ; chỉ chuyển sang văn bản mới nếu cơ quan quản lý có công văn yêu cầu riêng đối với từng hồ sơ", "B": "Áp dụng đồng thời toàn bộ quy định cũ và mới, chọn nội dung có lợi hơn cho cơ sở đăng ký mà không cần xem xét điều khoản hiệu lực hoặc chuyển tiếp", "C": "Ưu tiên áp dụng văn bản mới nhất đã được ban hành, kể cả khi chưa có hiệu lực, vì hồ sơ có thể được giải quyết sau ngày văn bản bắt đầu có hiệu lực", "D": "Luôn cập nhật và áp dụng quy định của văn bản mới nhất đang có hiệu lực, đồng thời soi chiếu kỹ \"Điều khoản chuyển tiếp\" (nếu có)"}, "answer": "D", "explanation": "Nguyên tắc là cập nhật văn bản mới đang có hiệu lực và đồng thời kiểm tra kỹ điều khoản chuyển tiếp để xác định quy định áp dụng cho hồ sơ cụ thể.", "lesson": 1}, {"n": 31, "q": "Theo Thông tư số 12/2025/TT-BYT, mô tả nào phản ánh đúng khái niệm “cơ sở sản xuất thuốc”?", "options": {"A": "Cơ sở chỉ thực hiện nhập khẩu, phân phối và theo dõi thuốc sau khi thuốc được cấp phép lưu hành", "B": "Cơ sở sở hữu giấy phép lưu hành thuốc được ghi trên CPP theo mẫu của Tổ chức Y tế thế giới", "C": "Cơ sở đứng tên nộp đơn đề nghị cấp, gia hạn, thay đổi, bổ sung giấy đăng ký lưu hành thuốc", "D": "Cơ sở thực hiện một, một số công đoạn hoặc toàn bộ quá trình sản xuất, hoặc thực hiện việc xuất xưởng lô thuốc"}, "answer": "D", "explanation": "Cơ sở sản xuất thuốc là cơ sở thực hiện một, một số công đoạn hoặc toàn bộ quá trình sản xuất, hoặc thực hiện việc xuất xưởng lô thuốc.", "lesson": 1}, {"n": 32, "q": "Theo Thông tư số 12/2025/TT-BYT, “chủ sở hữu giấy phép lưu hành thuốc” được xác định là chủ thể nào?", "options": {"A": "Cơ sở nhập khẩu và phân phối thuốc đầu tiên tại Việt Nam sau khi thuốc được cấp phép", "B": "Cơ sở chịu trách nhiệm xuất xưởng lô thuốc cuối cùng trước khi đưa thuốc ra thị trường", "C": "Cơ sở sở hữu giấy phép lưu hành thuốc được ghi trên CPP theo mẫu của Tổ chức Y tế thế giới", "D": "Cơ sở đứng tên nộp đơn đăng ký lưu hành thuốc tại Việt Nam trong mọi trường hợp"}, "answer": "C", "explanation": "Chủ sở hữu giấy phép lưu hành thuốc là cơ sở sở hữu giấy phép lưu hành được ghi trên CPP theo mẫu của WHO.", "lesson": 1}, {"n": 33, "q": "Một kháng sinh được tạo ra bằng quá trình sinh học. Khi xác định nhóm sản phẩm, nhận định nào phù hợp với định nghĩa “sinh phẩm” trong Luật số 44/2024/QH15?", "options": {"A": "Luôn xếp sản phẩm vào nhóm sinh phẩm vì mọi thuốc được tạo ra bằng công nghệ hoặc quá trình sinh học đều thuộc cùng một nhóm pháp lý", "B": "Không xếp sản phẩm vào nhóm sinh phẩm chỉ vì được tạo ra bằng quá trình sinh học, vì kháng sinh không thuộc phạm vi khái niệm sinh phẩm", "C": "Xếp sản phẩm vào nhóm thuốc cổ truyền vì nguồn gốc vi sinh vật được xem là căn cứ thay thế cho lý luận y học cổ truyền và kinh nghiệm dân gian", "D": "Xếp sản phẩm vào nhóm nguyên liệu làm thuốc vì kháng sinh không thể được đăng ký dưới dạng thuốc thành phẩm, bất kể dạng bào chế và mục đích sử dụng"}, "answer": "B", "explanation": "Theo định nghĩa được sử dụng trong câu hỏi, không phải cứ sản phẩm được tạo ra bằng quá trình sinh học là tự động xếp vào nhóm sinh phẩm; kháng sinh được loại trừ khỏi phạm vi khái niệm sinh phẩm nêu ở đây.", "lesson": 1}, {"n": 34, "q": "Theo Điều 25 Thông tư số 12/2025/TT-BYT, hồ sơ đăng ký thuốc có chứa hoạt chất tinh khiết chiết xuất từ dược liệu được cấu trúc theo phương án nào?", "options": {"A": "Bốn phần ACTD gồm hành chính, chất lượng, tiền lâm sàng và lâm sàng như mọi thuốc hóa dược", "B": "Phần I hồ sơ hành chính, Phần II hồ sơ chất lượng và Phần III dữ liệu lâm sàng hoặc dữ liệu trích dẫn theo quy định", "C": "Hồ sơ thuốc cổ truyền theo Thông tư số 29/2025/TT-BYT, không áp dụng cấu trúc tại Thông tư số 12/2025/TT-BYT", "D": "Phần I hồ sơ hành chính và Phần II hồ sơ chất lượng, không có phần dữ liệu an toàn, hiệu quả"}, "answer": "B", "explanation": "Theo Điều 25 TT12, hồ sơ thuốc chứa hoạt chất tinh khiết chiết xuất từ dược liệu gồm Phần I hành chính, Phần II chất lượng và Phần III dữ liệu lâm sàng hoặc dữ liệu trích dẫn theo quy định.", "lesson": 1}, {"n": 35,
